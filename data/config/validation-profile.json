{
  "schema_version": 2,
  "profile_id": "2023-rav4-hv-xa50-a25a-fxs",
  "description": "Catalog, selection rules, tier policy, and backend are shared by every ECU behind the DLC3 gateway; each entry adds only its endpoint and paths.",
  "transport": {
    "bitrate": 500000,
    "addressing": "normal"
  },
  "catalog": {
    "path": "data/catalog/telemetry.csv",
    "acquisition": "direct DID"
  },
  "selection": {
    "did_min": "0x0100",
    "did_max": "0xEFFF",
    "max_response_bytes": 512,
    "maximum_dids_per_road_batch": 6,
    "default_tier": "normal",
    "identity_words": [],
    "private_words": [],
    "tier_words": {
      "fast": [
        "speed",
        "revolution",
        "torque",
        "current",
        "power",
        "voltage",
        "accelerator",
        "steering",
        "yaw",
        "rate",
        "frequency",
        "duty"
      ],
      "slow": [
        "temperature",
        "pressure",
        "state of charge",
        "soc",
        "level",
        "resistance",
        "capacity",
        "thermal"
      ],
      "archive": [
        "counter",
        "history",
        "integrated",
        "accumulated",
        "elapsed",
        "total time",
        "life attainment",
        "just after ig on",
        "before last",
        "trip before",
        "freeze",
        "learning value",
        "maximum",
        "minimum",
        "specification"
      ]
    }
  },
  "policies": {
    "fast": {
      "period_ms": 100,
      "duration_seconds": 120,
      "minimum_samples_per_did": 100
    },
    "normal": {
      "period_ms": 250,
      "duration_seconds": 300,
      "minimum_samples_per_did": 120
    },
    "slow": {
      "period_ms": 1000,
      "duration_seconds": 900,
      "minimum_samples_per_did": 60
    },
    "archive": {
      "period_ms": 2000,
      "duration_seconds": 600,
      "minimum_samples_per_did": 20
    }
  },
  "road_default_tiers": [
    "fast",
    "normal",
    "slow"
  ],
  "qualification_period_ms": 100,
  "terminal_nrcs": [
    "0x31",
    "0x33"
  ],
  "analysis": {
    "decode_overrides": "data/config/decode-overrides.json"
  },
  "backend": {
    "schema_version": 1,
    "executable": "scratch/bin/telemetry-pcan.exe",
    "arguments": [
      "--config",
      "data/config/backend-config.json"
    ],
    "mode_arguments": {
      "qualification": [
        "--candidate-qualify",
        "--live"
      ],
      "road": [
        "--candidate-batch",
        "--live"
      ]
    }
  },
  "ecus": [
    {
